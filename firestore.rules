rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function familyDoc(familyId) {
      return /databases/$(database)/documents/families/$(familyId);
    }
    function isFamilyPublic(familyId) {
      return exists(familyDoc(familyId)) && get(familyDoc(familyId)).data.isPublic == true;
    }
    function isFamilyOwner(familyId) {
      return request.auth != null
        && exists(familyDoc(familyId))
        && request.auth.uid == get(familyDoc(familyId)).data.userId;
    }

    // Users collection: Only the user themselves can read/write their profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Families collection
    match /families/{familyId} {
      // Allow read if family is public OR if the user is the owner
      allow read: if resource.data.isPublic == true || (request.auth != null && request.auth.uid == resource.data.userId);
      // Allow create if authenticated
      allow create: if request.auth != null;
      // Allow update/delete only if the user is the owner
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Members collection
    match /members/{memberId} {
      // Allow read if the associated family is public OR if the user is the owner of that family
      // Note: This uses a get() call to check the family document. 
      // Ensure your data structure has familyId in every member document.
      allow read: if (resource.data.familyId is string && isFamilyPublic(resource.data.familyId))
        || (resource.data.familyId is string && isFamilyOwner(resource.data.familyId));
      
      // Allow create if authenticated (you might want to further restrict this to owners only)
      allow create: if request.auth != null;
      
      // Allow update/delete only if the user is the owner of the family
      allow update, delete: if resource.data.familyId is string && isFamilyOwner(resource.data.familyId);
    }
  }
}
